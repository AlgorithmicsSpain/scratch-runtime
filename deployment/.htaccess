Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://assets.scratch.mit.edu; media-src 'self' data: blob: https://assets.scratch.mit.edu; connect-src 'self' https://assets.scratch.mit.edu; worker-src 'self' blob:; frame-src 'self' blob:; frame-ancestors https://lms.algorithmicsespana.com; object-src 'none'; base-uri 'none'; form-action 'none'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), display-capture=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Cache-Control "no-cache"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|map|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
